[Unit]
Description=Ginbar v2 Go API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=ginbar
Group=ginbar
EnvironmentFile=/etc/ginbar/v2/api.env
Environment=LISTEN_ADDR=127.0.0.1:8080
Environment=GINBAR_MEDIA_SOURCE_ROOT=/srv/ginbar/media
ExecStart=/usr/local/bin/ginbar-api-v2
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=control-group
OOMPolicy=kill
LimitNOFILE=4096
TasksMax=256
MemoryAccounting=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
